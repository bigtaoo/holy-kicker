{
  // Static hosting (Cloudflare Workers static assets) for the web build of the game, served
  // at h.gamestao.com. Mirrors daydayup's wrangler/client.jsonc (same gamestao.com account).
  //
  // Build (outputs client/dist):   npm run build
  // Deploy (from the repo root):   npx wrangler deploy -c wrangler/web.jsonc
  //
  // routes[].custom_domain=true provisions the DNS record and edge certificate on the first
  // deploy. The game talks to its backend at hk.gamestao.com (CORS is open there).
  "name": "holy-kicker-web",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "h.gamestao.com", "custom_domain": true }
  ]
}
