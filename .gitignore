# Tool run logs (art generation and the like)
*.log

# Raw store video recordings (tools/record_video.mjs); only the cut videos are kept
art/store/video/raw/
art/store/video/ios_preview_*
art/reskin/corgi/store/video/raw/
art/reskin/corgi/store/video/ios_preview_*

# Release zips built for portal uploads (D:\standing\release)
release/

# Coverage reports (npm run coverage); the floors are build/coverage-floors.json
coverage/
# the layout sweep's screenshots and report (npm run sweep:layout)
layout-report/
